# SPRoot — AP 守护开机自启（ramdisk 注入模板）
#
# 本文件由 SPRoot Manager 在修补流水线（RcInject 步骤）中注入到 ramdisk：
#   /init.sproot.rc          ← 本文件原文
#   并在 /init.rc 中确保存在一行：import /init.sproot.rc
#
# ⚠️ 铁律：密钥绝不写入本文件。rc 位于 ramdisk 中，任何明文密钥等于泄露。
#    daemon 通过 --superkey-file 从固定受保护路径读取（见下）。
#
# ⚠️ 安全失败设计（防 bootloop）：
#    - oneshot + disabled：daemon 退出后 init 不会重启它 → 最坏情况是"自启失效"，绝不会开机循环
#    - 仅由 property 触发器 start 一次；若 /data/adb/apd 或 key 文件不存在，start 失败仅留 init 日志
#    - 因此本模板在"AP 未部署"的设备上是**惰性无害**的
#
# 依赖（由 apd deploy 负责建立，非本文件职责）：
#    /data/adb/apd                      apd 可执行文件（aarch64）
#    /data/adb/sproot/key          0600 root:root，内容为 47 字符密钥（无 NUL，逐行为纯文本）
#                                  —— 与 apd/src/defs.rs::SPROOT_KEY_FILE 严格一致；
#                                     由 apd deploy 的 step 5/10 原子写入（tmp+fsync+rename）
#    /data/adb/sproot/                 0700 root:root

on post-fs-data
    mkdir /data/adb/sproot 0700 root root
    # 密钥文件由 apd deploy 写入（0600）。此处只建目录，绝不写密钥。
    #
    # Zygisk 启动链（关键）：exec 是 init 的**阻塞**原语 —— init 等其结束才启动 zygote。
    # apd post-fs-data 会执行所有模块的 post-fs-data.sh（NeoZygisk 起 zygiskd、
    # Mountify 建 overlay），因此本行保证 **zygiskd 先于 zygote 就绪**。
    # 缺此行 → Zygisk 注入必然失败（表现为静默无效）。
    # 风险：apd post-fs-data 卡住会拖慢开机 —— apd 侧需该阶段硬超时。
    exec -- /data/adb/apd post-fs-data
    #
    # Zygisk 启动链（关键）：exec 是 init 的**阻塞**原语 —— init 会等该进程结束
    # 才继续启动 zygote。apd post-fs-data 会遍历执行所有模块的 post-fs-data.sh，
    # 其中 NeoZygisk 在此阶段启动 zygiskd、Mountify 在此阶段建立 overlay 挂载。
    # 因此本行保证：**zygiskd 一定在 zygote 之前就绪**。
    # 缺这一行 → zygiskd 晚于 zygote → Zygisk 注入必然失败（且表现为静默无效）。
    # 风险：若 apd post-fs-data 卡住会拖慢开机（不是崩溃，是卡住）—— apd 侧需有
    #       该阶段的硬超时；C′ rc 虚拟化模板必须与本行保持一致。
    exec -- /data/adb/apd post-fs-data

# ⚠️ 参数顺序（clap）：--superkey-file 是 apd 的**顶层**参数，必须写在子命令 daemon 之前。
#    写成 `apd daemon --superkey-file ...` 会被 clap 判为 unexpected argument（rc=2），
#    daemon 根本起不来；RcInject 按本文件原文注入，故顺序在这里就是最终生效顺序。
service sproot-apd /data/adb/apd --superkey-file /data/adb/sproot/key daemon
    class late_start
    user root
    group root
    oneshot
    disabled
    # override 仅用于覆盖同名 service（重复注入时的幂等保护）
    override
    # ---------------------------------------------------------------------
    # seclabel：默认继承 init 上下文 u:r:init:s0。
    # 若真机日志出现 avc denied（exec /data/adb/apd 或 socket 创建被拒），
    # 再按机型评估是否需要显式 seclabel；**不要盲加**，加错会导致 daemon 无法启动。
    # 记录于 docs/NEW-DOC-05 §3.1.3；需 S2 真机确认后固化为默认值。
    # ---------------------------------------------------------------------

# 启动时机：等系统启动完成后再拉起，避免与 post-fs-data 阶段争用
on property:sys.boot_completed=1
    start sproot-apd

# 守护自身负责持续运行；若其异常退出，宁可停止自启也不进入重启风暴。
