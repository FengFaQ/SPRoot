<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 不申请网络权限：本 App 修补全程离线，禁止构建期/运行期静默下载（旧版缺陷 ③） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 9 及以下导出产物到公共 Downloads 需要；Android 10+ 走 MediaStore 无需权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- App 自引导（人类指令 A）：BOOT_COMPLETED 时拉起 AP 守护，不再依赖 init_boot rc -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- SK 引擎/magiskboot 只交付 arm64 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- miuix-blur 声明 minSdk 33（RenderEffect 要求）。本 App 全程用
         isRenderEffectSupported()（SDK_INT >= 31）守卫，低版本自动退化为不透明色，
         因此允许合并。（与 KernelSU 的 miuix 版同样处理） -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <application
        android:name=".SPRootApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SPRoot">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SPRoot"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机自引导：收到 BOOT_COMPLETED 后确保 AP 守护在运行（幂等，先探测后拉起） -->
        <receiver
            android:name=".core.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
